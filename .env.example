# ---------------------------------------------------------------------------
# NorthWinds Operations Console — environment
# Copy to `.env.local`. Never commit `.env.local`.
#
# The demo runs with NONE of these set. Every integration degrades gracefully
# to mock or cached data, so a missing key never breaks the dashboard — see
# lib/utils/api-handler.ts.
# ---------------------------------------------------------------------------

# --- AI executive briefing (PRD §7) ----------------------------------------
# Optional. Without it, the briefing falls back to a deterministic rule-based
# analysis computed from live figures, clearly labelled as such in the UI.
# Note: the PRD specified OpenAI/gpt-4o; this build uses Claude instead.
ANTHROPIC_API_KEY=

# --- Supabase (deferred — not yet connected) -------------------------------
# The schema, RLS policies and seed data are written and ready in supabase/.
# Populate these when moving off the mock data layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- QuickBooks Online (production hook) -----------------------------------
# Mock transformer currently returns generated data.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=

# --- Controlio (production hook) -------------------------------------------
CONTROLIO_API_KEY=
CONTROLIO_BASE_URL=

# --- FX ---------------------------------------------------------------------
# USD/PHP comes from the ECB via api.frankfurter.app, which needs no API key.
# Nothing to configure. Listed here only so nobody goes looking for a key.
